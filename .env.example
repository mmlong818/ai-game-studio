HOST=127.0.0.1
PORT=4312
PUBLIC_ORIGIN=http://127.0.0.1:4312
# 本地 Docker PostgreSQL 默认只绑定 127.0.0.1；trust 认证仅用于本机开发。
DATABASE_URL=postgresql://studio@127.0.0.1:54329/ai_game_studio
# 首次启动且 PostgreSQL 为空时，只读导入旧 SQLite，不修改旧文件。
LEGACY_SQLITE_PATH=./data/studio.db
# OpenAI API Key 的本机密钥文件（单行内容即密钥；data/ 不入版本库）。
# 也可直接设置 OPENAI_API_KEY 环境变量；优先级：会话密钥 > 密钥文件 > 环境变量。
OPENAI_API_KEY_FILE=./data/secrets/openai-api-key.txt
