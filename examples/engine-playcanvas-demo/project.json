  "rules": [
    {
      "id": "RULE-COLLECT-STAR",
      "name": "纸偶碰到折纸星就计一颗",
      "sceneId": "SCENE-GARDEN",
      "enabled": true,
      "priority": "P0",
      "when": [{ "type": "collision.overlap", "parameters": {}, "references": [{ "kind": "object", "id": "OBJECT-PLAYER" }, { "kind": "object", "id": "OBJECT-STAR" }] }],
      "then": [
        { "type": "variable.add", "parameters": { "id": "VARIABLE-STARS", "value": 1 }, "references": [] },
        { "type": "feedback.emit", "parameters": { "type": "collect" }, "references": [] }
      ]
    },
    {
      "id": "RULE-ALL-STARS",
      "name": "集齐三颗星即通关",
      "sceneId": "SCENE-GARDEN",
      "enabled": true,
      "priority": "P0",
      "when": [
        { "type": "state.is", "parameters": { "value": "playing" }, "references": [] },
        { "type": "variable.compare", "parameters": { "id": "VARIABLE-STARS", "operator": "greater-or-equal", "value": 3 }, "references": [] }
      ],
      "then": [
        { "type": "state.set", "parameters": { "value": "won" }, "references": [] },
        { "type": "feedback.emit", "parameters": { "type": "victory" }, "references": [] }
      ]
    },
    {
      "id": "RULE-WAVE-HIT",
      "name": "被纸浪撞到记一次失误",
      "sceneId": "SCENE-GARDEN",
      "enabled": true,
      "priority": "P1",
      "when": [{ "type": "collision.overlap", "parameters": {}, "references": [{ "kind": "object", "id": "OBJECT-PLAYER" }, { "kind": "object", "id": "OBJECT-WAVE" }] }],
      "then": [
        { "type": "variable.add", "parameters": { "id": "VARIABLE-MISTAKES", "value": 1 }, "references": [] },
        { "type": "feedback.emit", "parameters": { "type": "hit" }, "references": [] }
      ]
    }
